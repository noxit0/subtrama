---
import Base from '../../layouts/Base.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import FeatureList from '../../components/FeatureList.astro';
import Callout from '../../components/Callout.astro';
import Button from '../../components/Button.astro';
import PriceCard from '../../components/PriceCard.astro';
import { getPaquetes, getCondiciones, getAdicionales, formatoPrecio } from '../../lib/contenido';

export async function getStaticPaths() {
  const paquetes = await getPaquetes();
  return paquetes.map((paquete, i) => ({
    params: { slug: paquete.slug },
    props: { paquete, anterior: paquetes[i - 1], siguiente: paquetes[i + 1] },
  }));
}

const { paquete, anterior, siguiente } = Astro.props;
const cond = await getCondiciones();
const adicionales = await getAdicionales();
const personalizable = paquete.tipo === 'personalizable';
const precio = (n?: number) => (n != null ? formatoPrecio(n) : 'A consultar');
---
<Base title={`Paquete ${paquete.nombre}`} description={paquete.resumen}>
  <section class="section">
    <div class="container">
      <p class="breadcrumb"><a href="/servicios/">Servicios</a></p>
      <div class="section-head">
        <SectionTitle as="h1" title={paquete.nombre} eyebrow="Paquete" />
        <p class="servicio-intro">{paquete.resumen}</p>
      </div>
      <div class="servicio-layout">
        <div class="paquete-detalle">
          <div>
            <span class="st-eyebrow" style="margin-bottom:var(--space-3)">Qué incluye</span>
            <FeatureList items={paquete.incluye} />
          </div>
          <div>
            <span class="st-eyebrow" style="margin-bottom:var(--space-3)">Para quién es</span>
            <p>{paquete.para_quien}</p>
          </div>
        </div>
        {personalizable ? (
          <Callout label="Cómo funciona">
            <p>Elegís los servicios de la lista, definimos las cantidades juntos y el valor surge de sumar cada uno.</p>
          </Callout>
        ) : (
          <PriceCard plan={paquete.nombre} precio={paquete.precio != null ? formatoPrecio(paquete.precio) : undefined}>
            <ul class="price-notes">
              <li>{cond.nota_impuestos}</li>
              <li>Precios vigentes desde el {cond.vigencia_desde}.</li>
              <li>Plazo mínimo de contratación: {cond.plazo_minimo}.</li>
              <li>{cond.ajuste}</li>
            </ul>
          </PriceCard>
        )}
      </div>
    </div>
  </section>

  {personalizable && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <SectionTitle title="Precio por servicio" />
          <p>Valores unitarios en pesos argentinos. {cond.nota_impuestos} Vigentes desde el {cond.vigencia_desde}.</p>
        </div>
        <div class="st-table-wrap">
          <table class="st-table">
            <caption>Servicios del paquete personalizable</caption>
            <thead>
              <tr><th scope="col">Servicio</th><th scope="col">Unidad</th><th scope="col">Qué incluye</th><th scope="col" class="st-num">Precio</th></tr>
            </thead>
            <tbody>
              {paquete.precios_unitarios.map((u) => (
                <tr><th scope="row">{u.servicio}</th><td>{u.unidad}</td><td>{u.incluye}</td><td class="st-num">{precio(u.precio)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-head">
        <SectionTitle title="Adicionales" />
        <p>Si necesitás algo fuera del paquete, se suma con su propio valor.</p>
      </div>
      <div class="st-table-wrap">
        <table class="st-table">
          <caption>Adicionales</caption>
          <thead><tr><th scope="col">Adicional</th><th scope="col" class="st-num">Precio</th></tr></thead>
          <tbody>
            {adicionales.map((a) => (
              <tr><th scope="row">{a.nombre}</th><td class="st-num">{precio(a.precio)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="condiciones">
        <span class="st-eyebrow">Condiciones</span>
        <ul>
          {cond.condiciones.map((c) => <li>{c.texto}</li>)}
        </ul>
      </div>
      <div class="servicio-nav">
        {anterior ? <Button href={`/paquetes/${anterior.slug}/`} variant="secondary">← {anterior.nombre}</Button> : <span />}
        {siguiente ? <Button href={`/paquetes/${siguiente.slug}/`} variant="secondary">{siguiente.nombre} →</Button> : <span />}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Hablemos de tu marca</h2>
        <p>Contanos qué hacés y qué necesitás. Armamos el plan a partir de ahí.</p>
        <Button href={`/contacto/?paquete=${paquete.slug}`} variant="accent" size="lg">Agendar reunión</Button>
      </div>
    </div>
  </section>
</Base>
