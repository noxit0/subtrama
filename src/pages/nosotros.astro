---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Button from '../components/Button.astro';
import { migas } from '../lib/seo';
---
<Base
  title="Nosotros, espacio de marketing digital"
  description="Subtrama es un espacio de marketing digital en Olavarría y la región. Ordenamos, publicamos y medimos el contenido en redes de marcas con oficio e historia."
  datos={[migas(Astro.site!, [{ nombre: 'Inicio', ruta: '/' }, { nombre: 'Nosotros', ruta: '/nosotros/' }])]}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <SectionTitle as="h1" title="Nosotros" eyebrow="Quiénes somos" />
        <p>
          Subtrama es un espacio de marketing digital. Ordenamos, publicamos y medimos el contenido en redes de marcas con oficio e historia. Somos un equipo reducido con atención directa: trabajás siempre con las mismas personas, sin intermediarios.
        </p>
      </div>
      <!-- Principios numerados, con el mismo lenguaje que "Cómo trabajamos" en la página de inicio. -->
      <ol class="proceso principios">
        {[
          { titulo: 'Concreta', texto: 'Diagnosticamos con datos. Nombramos el problema en lugar de rodearlo.' },
          { titulo: 'Transparente', texto: 'Explicamos el porqué de cada recomendación. Vos decidís qué hacer con ella.' },
          { titulo: 'Con alcance claro', texto: 'Definimos qué hacemos y qué no. Así las expectativas quedan alineadas desde el inicio.' },
        ].map((p, i) => (
          <li class="revelar">
            <span class="proceso-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="proceso-cuerpo">
              <h2>{p.titulo}</h2>
              <p>{p.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Conozcámonos</h2>
        <p>Una primera reunión permite definir si trabajar juntos tiene sentido.</p>
        <Button href="/contacto/" variant="accent" size="lg">Agendar reunión</Button>
      </div>
    </div>
  </section>
</Base>
