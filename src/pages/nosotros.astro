---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Card from '../components/Card.astro';
import Lead from '../components/Lead.astro';
import Button from '../components/Button.astro';
---
<Base
  title="Nosotros"
  description="Subtrama es un espacio de marketing digital. Gestionamos redes y estrategia de contenido para marcas con oficio e historia."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <SectionTitle as="h1" title="Nosotros" eyebrow="Quiénes somos" />
        <p>
          Subtrama es un espacio de marketing digital. Gestionamos redes y estrategia de contenido para marcas con oficio e historia. Somos la trama invisible que conecta tu historia con el mundo digital.
        </p>
      </div>
      <div class="grid-cards">
        <Card as="h2" title="Concreta" tone="accent-2">
          <Lead lead="Diagnosticamos con datos.">Nombramos el problema en lugar de rodearlo.</Lead>
        </Card>
        <Card as="h2" title="Transparente" tone="accent-2">
          <Lead lead="Explicamos el porqué de cada recomendación.">Vos decidís qué hacer con ella.</Lead>
        </Card>
        <Card as="h2" title="Con alcance claro" tone="accent-2">
          <Lead lead="Definimos qué hacemos y qué no.">Así las expectativas quedan alineadas desde el inicio.</Lead>
        </Card>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Conozcámonos</h2>
        <p>Una primera reunión permite definir si trabajar juntos tiene sentido.</p>
        <Button href="/contacto/" variant="accent" size="lg">Agendar reunión</Button>
      </div>
    </div>
  </section>
</Base>
