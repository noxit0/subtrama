---
import Base from '../../layouts/Base.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import FeatureList from '../../components/FeatureList.astro';
import Callout from '../../components/Callout.astro';
import Button from '../../components/Button.astro';
import InformeEjemplo from '../../components/InformeEjemplo.astro';
import { getServicios, ETAPAS } from '../../lib/servicios';
import { migas, servicioLd, recortar } from '../../lib/seo';

export async function getStaticPaths() {
  const servicios = await getServicios();
  return servicios.map((servicio, i) => ({
    params: { slug: servicio.slug },
    props: {
      servicio,
      anterior: servicios[i - 1],
      siguiente: servicios[i + 1],
    },
  }));
}

const { servicio, anterior, siguiente } = Astro.props;
const etapa = ETAPAS.find((e) => e.id === servicio.etapa)!;
const descripcion = recortar(`${servicio.resumen} ${servicio.entrega}`);
---
<Base
  title={`${servicio.titulo} para redes sociales`}
  description={descripcion}
  datos={[
    migas(Astro.site!, [
      { nombre: 'Inicio', ruta: '/' },
      { nombre: 'Servicios', ruta: '/servicios/' },
      { nombre: servicio.titulo, ruta: `/servicios/${servicio.slug}/` },
    ]),
    servicioLd(Astro.site!, { nombre: servicio.titulo, descripcion, ruta: `/servicios/${servicio.slug}/`, tipo: 'Marketing digital y redes sociales' }),
  ]}
>
  <section class="section">
    <div class="container">
      <p class="breadcrumb"><a href="/servicios/">Servicios</a></p>
      <div class="section-head">
        <SectionTitle as="h1" eyebrow={`Etapa ${ETAPAS.indexOf(etapa) + 1}: ${etapa.nombre}`} title={servicio.titulo} />
        <p class="servicio-intro">{servicio.intro}</p>
      </div>
      <div class="servicio-layout">
        <div>
          <span class="st-eyebrow" style="margin-bottom:var(--space-3)">Qué incluye</span>
          <FeatureList items={servicio.incluye} />
        </div>
        <Callout label="Qué recibís">
          <p>{servicio.entrega}</p>
        </Callout>
      </div>
      {servicio.slug === 'informes' && <InformeEjemplo />}
      <div class="servicio-nav">
        {anterior ? <Button href={`/servicios/${anterior.slug}/`} variant="secondary">← {anterior.titulo}</Button> : <span />}
        {siguiente ? <Button href={`/servicios/${siguiente.slug}/`} variant="secondary">{siguiente.titulo} →</Button> : <span />}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Contanos sobre tu marca</h2>
        <p>Contanos qué hacés y qué necesitás. Elaboramos el plan a partir de ahí.</p>
        <Button href="/contacto/" variant="accent" size="lg">Agendar reunión</Button>
      </div>
    </div>
  </section>
</Base>
