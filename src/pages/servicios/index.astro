---
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import PaqueteCard from '../../components/PaqueteCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Button from '../../components/Button.astro';
import { getServicios } from '../../lib/servicios';
import { getPaquetes, getCondiciones, getPreguntas } from '../../lib/contenido';
const servicios = await getServicios();
const paquetes = await getPaquetes();
const cerrados = paquetes.filter((p) => p.tipo === 'cerrado' && p.detalle);
const cond = await getCondiciones();
const preguntas = await getPreguntas();
const faqJson = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((q) => ({ '@type': 'Question', name: q.pregunta, acceptedAnswer: { '@type': 'Answer', text: q.respuesta } })),
});
const filas: { label: string; valor: (p: (typeof cerrados)[number]) => string }[] = [
  { label: 'Piezas de feed', valor: (p) => p.detalle!.piezas },
  { label: 'Historias', valor: (p) => p.detalle!.historias },
  { label: 'Jornada de registro', valor: (p) => p.detalle!.jornada },
  { label: 'Informe y reunión', valor: (p) => p.detalle!.informe },
  { label: 'Calendarización', valor: (p) => p.detalle!.calendarizacion },
];
---
<Base
  title="Servicios"
  description="Paquetes Esencial, Impulso y A Medida para gestionar redes y contenido, con el detalle de cada servicio."
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <SectionTitle as="h1" title="Servicios" eyebrow="Qué hacemos" />
        <p>Los servicios se contratan en paquetes. Elegí el que se ajuste a tu marca o diseñá uno a tu medida junto con nosotros.</p>
      </div>
      <div class="grid-cards grid-paquetes">
        {paquetes.map((p, i) => <PaqueteCard paquete={p} indice={i} as="h2" />)}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <SectionTitle title="Comparación de paquetes" />
        <p>Plazo mínimo de contratación: {cond.plazo_minimo}. El valor se informa en la propuesta.</p>
      </div>
      <div class="st-table-wrap">
        <table class="st-table">
          <caption>Paquetes cerrados</caption>
          <thead>
            <tr>
              <th scope="col">Concepto</th>
              {cerrados.map((p) => <th scope="col"><a href={`/paquetes/${p.slug}/`}>{p.nombre}</a></th>)}
            </tr>
          </thead>
          <tbody>
            {filas.map((f) => (
              <tr><th scope="row">{f.label}</th>{cerrados.map((p) => <td>{f.valor(p)}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="tabla-nota">{cond.ajuste}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <SectionTitle title="Qué incluyen los servicios" />
        <p>Cada paquete combina estos servicios. Acá está el detalle de cada uno.</p>
      </div>
      <div class="grid-cards">
        {servicios.map((s, i) => (
          <a class="card-link" href={`/servicios/${s.slug}/`}>
            <Card title={s.etiqueta} tone={i % 2 === 0 ? 'accent-2' : 'accent'} number={i + 1}>
              <p class="card-service">{s.titulo}</p>
              <p>{s.resumen}</p>
              <span class="card-more">Ver detalle</span>
            </Card>
          </a>
        ))}
      </div>
    </div>
  </section>

  {preguntas.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <SectionTitle title="Preguntas frecuentes" />
        </div>
        <div class="faq">
          {preguntas.map((q) => (
            <details>
              <summary>{q.pregunta}</summary>
              <p>{q.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
      <script type="application/ld+json" set:html={faqJson} />
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>¿Por dónde comenzar?</h2>
        <p>Todos los paquetes comienzan con el Kit de Marca, que incluye el análisis situacional. Contanos qué hacés y dónde estás hoy: te indicamos qué paquete se ajusta mejor.</p>
        <Button href="/contacto/" variant="accent" size="lg">Agendar reunión</Button>
      </div>
    </div>
  </section>
</Base>
