---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PaqueteCard from '../components/PaqueteCard.astro';
import { getPaquetes, getSeccionesInicio, getProceso, getMarcas, getManifiesto } from '../lib/contenido';
import Marcas from '../components/Marcas.astro';
import HeroVisual from '../components/HeroVisual.astro';
const paquetes = await getPaquetes();
const secciones = await getSeccionesInicio();
const proceso = await getProceso();
const marcas = await getMarcas();
const manifiesto = await getManifiesto();
// El manifiesto va sobre el fondo base; el resto de las secciones alterna fondo arena y base.
const conFondo = secciones.filter((t) => t !== 'manifiesto');
const esAlt = (tipo: string) => tipo !== 'manifiesto' && conFondo.indexOf(tipo as never) % 2 === 0;
const dosDigitos = (n: number) => String(n).padStart(2, '0');
// Palabras separadas para animarlas una por una (entrada del título y manifiesto).
const titulo = 'Vos creás tu mundo. Nosotros lo contamos en redes.'.split(' ');
const manifiestoPalabras = manifiesto ? manifiesto.texto.trim().split(/\s+/) : [];
const manifiestoDestacadas = manifiesto?.destacado ? manifiesto.destacado.trim().split(/\s+/) : [];
// Ritmo de la pantalla de entrada, calcado de la frase dicha en voz alta: una palabra cada PASO
// segundos y una PAUSA extra tras cada coma o punto (y antes de la parte destacada).
const PASO = 0.28;
const PAUSA = 0.4;
const SOSTEN = 0.5; // tiempo que se queda la frase completa antes de salir
const entrada: { p: string; d: number; dest: boolean }[] = [];
let t = 0;
[...manifiestoPalabras.map((p) => ({ p, dest: false })), ...manifiestoDestacadas.map((p) => ({ p, dest: true }))].forEach((w, n, todas) => {
  entrada.push({ ...w, d: Number(t.toFixed(2)) });
  const siguienteDest = todas[n + 1]?.dest && !w.dest;
  t += PASO + (/[.,;:]$/.test(w.p) || siguienteDest ? PAUSA : 0);
});
const ultimaDemora = entrada.length ? entrada[entrada.length - 1].d : 0;
const ondaDemora = Number((ultimaDemora + 0.2).toFixed(2));
// La onda dura 0,8 s; después la frase queda completa SOSTEN segundos. Ese es el mínimo antes de salir.
const introMin = Math.round((ondaDemora + 0.8 + SOSTEN) * 1000);
---
<Base
  title="Subtrama | Community manager y gestión de redes en Olavarría"
  description="Community manager en Olavarría y la región. Ordenamos, publicamos y medimos el contenido en redes de comercios, talleres, industrias, pymes y profesionales."
>
  {manifiesto && (
    <div class="intro" id="intro" aria-hidden="true" data-min={introMin} data-max={introMin + 500}>
      <p class="intro-frase">
        {entrada.map((w, n) => (
          <><span class={w.dest ? 'intro-w intro-dest' : 'intro-w'} style={`--d:${w.d}s`}>{w.p}{w.dest && n === entrada.length - 1 && '.'}</span>{n < entrada.length - 1 && ' '}</>
        ))}
      </p>
      <svg class="intro-onda" style={`--d:${ondaDemora}s`} viewBox="0 0 440 40" focusable="false"><path pathLength="1" d="M8 20 C 80 2 140 2 220 20 S 360 38 432 20" /></svg>
    </div>
  )}
  <noscript><style>.intro{display:none}</style></noscript>
  <script is:inline>
    (function () {
      var i = document.getElementById('intro');
      if (!i) return;
      try {
        if (sessionStorage.getItem('intro-visto') || matchMedia('(prefers-reduced-motion: reduce)').matches) { i.remove(); return; }
      } catch (e) {}
      document.documentElement.classList.add('intro-activa');
    })();
  </script>
  <div class="hilo-wrap">
  <svg class="hilo-svg" aria-hidden="true" focusable="false"><path pathLength="1" d="" /></svg>
  <span class="hilo-movil" aria-hidden="true"></span>
  <span class="pajaro" aria-hidden="true">
    <svg class="pajaro-svg" viewBox="4 12 98 112" focusable="false">
      <g class="pose posado">
        <path d="M80 27C74 20 62 21 57 31C52 41 51 54 44 66C36 78 24 94 9 117" />
        <path d="M9 117C20 104 32 94 46 88" />
        <path d="M9 117C14 108 22 99 30 93" />
        <path d="M82 38C79 48 81 60 75 71C69 80 60 86 46 88" />
        <path d="M50 50C60 52 67 61 64 73C61 81 50 85 41 84" />
        <path d="M44 62L50 72M41 70L48 79M43 78L50 83" />
        <path d="M62 86L62 99M68 85L70 99" />
        <path d="M58 99L62 99M66 99L70 99" />
        <circle cx="73" cy="30" r="1.8" />
        <path class="pico" d="M80 27L97 31L82 38" />
      </g>
      <g class="pose vuelo vuelo-a">
        <path d="M80 47C74 40 62 41 57 51C52 61 50 70 42 78C36 84 28 90 18 99" />
        <path d="M18 99C30 94 42 92 50 90" />
        <path d="M82 58C79 66 78 76 70 84C64 90 58 91 50 90" />
        <path d="M54 62C46 46 36 30 18 18C26 30 28 36 26 42C32 38 38 40 40 46C45 44 49 48 51 54" />
        <path d="M58 60C54 48 50 36 46 24" />
        <circle cx="73" cy="50" r="1.8" />
        <path class="pico" d="M80 47L97 51L82 58" />
      </g>
      <g class="pose vuelo vuelo-b">
        <path d="M80 37C74 30 62 31 57 41C52 51 50 60 42 68C36 74 28 80 18 89" />
        <path d="M18 89C30 84 42 82 50 80" />
        <path d="M82 48C79 56 78 66 70 74C64 80 58 81 50 80" />
        <path d="M54 56C46 72 36 88 18 100C26 88 28 82 26 76C32 80 38 78 40 72C45 74 49 70 51 64" />
        <path d="M58 58C54 70 50 82 46 94" />
        <circle cx="73" cy="40" r="1.8" />
        <path class="pico" d="M80 37L97 41L82 48" />
      </g>
    </svg>
  </span>
  <section class="hero">
    <div class="hero-copy surface-deep">
      <span class="st-eyebrow hero-fade" style="--d:0s">Community manager en Olavarría y la región</span>
      <h1 class="display">
        {titulo.map((p, n) => <><span class="hero-palabra" style={`--i:${n}`}>{p}</span>{n < titulo.length - 1 && ' '}</>)}
      </h1>
      <p class="hero-lead hero-fade" style="--d:1s">
        Somos Subtrama. Ordenamos tu contenido y lo publicamos con estrategia, para que tu marca se cuente sola.
      </p>
      <div class="hero-actions hero-fade" style="--d:1.2s">
        <Button href="/contacto/" size="lg">Agendar reunión</Button>
        <Button href="/servicios/" size="lg" variant="inverse">Ver paquetes</Button>
      </div>
    </div>
    <div class="hero-visual">
      <HeroVisual />
    </div>
  </section>
  {secciones.map((tipo) => (
    <section class:list={['section', { 'section-alt': esAlt(tipo), manifiesto: tipo === 'manifiesto' }]}>
      {tipo === 'manifiesto' && manifiesto && (
        <div class="container">
          <p class="manifiesto-texto">
            {manifiestoPalabras.map((p, n) => <><span class="mw" style={`--i:${n}`}>{p}</span>{' '}</>)}
            {manifiestoDestacadas.map((p, n) => (
              <><span class="mw mw-dest" style={`--i:${manifiestoPalabras.length + n + 1}`}>{p}{n === manifiestoDestacadas.length - 1 && '.'}</span>{n < manifiestoDestacadas.length - 1 && ' '}</>
            ))}
          </p>
          {manifiestoDestacadas.length > 0 && (
            <svg class="manifiesto-onda" viewBox="0 0 440 40" aria-hidden="true" focusable="false"><path pathLength="1" d="M8 20 C 80 2 140 2 220 20 S 360 38 432 20" /></svg>
          )}
        </div>
      )}
      {tipo === 'para-quien' && (
        <div class="container">
          <div class="section-head">
            <SectionTitle title="Para quién trabajamos" />
            <p>
              Trabajamos con comercios, talleres, industrias, pymes y profesionales de Olavarría y la región. Son marcas con oficio e historia. Las ayudamos a mostrarlo en redes con constancia y criterio.
            </p>
          </div>
          {marcas.length > 0 && <Marcas />}
        </div>
      )}
      {tipo === 'paquetes' && (
        <div class="container">
          <div class="section-head">
            <SectionTitle title="Paquetes" />
            <p>Dos paquetes cerrados y uno a medida. Elegí según cuánto contenido necesitás publicar por mes.</p>
          </div>
          <div class="grid-cards grid-paquetes">
            {paquetes.map((p, i) => <PaqueteCard paquete={p} indice={i} as="h3" />)}
          </div>
          <p class="tabla-nota">El valor se informa en la propuesta. <a href="/servicios/">Ver la comparación y los servicios</a>.</p>
        </div>
      )}
      {tipo === 'como-se-trabaja' && (
        <div class="container proceso-wrap">
          <div class="section-head proceso-head">
            <SectionTitle title="Cómo trabajamos" />
            <p>Cada mes acordamos el calendario, publicamos y te mostramos qué pasó con cada pieza.</p>
          </div>
          <ol class="proceso">
            {proceso.map((paso, i) => (
              <li class="revelar">
                <span class="proceso-num" aria-hidden="true">{dosDigitos(i + 1)}</span>
                <div class="proceso-cuerpo">
                  <h3>{paso.titulo}</h3>
                  <p>{paso.texto}</p>
                  {paso.enlace_texto && paso.enlace_url && (
                    <a class="proceso-enlace" href={paso.enlace_url}>
                      {paso.enlace_texto}
                      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>
  ))}
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Contanos sobre tu marca</h2>
        <p>Contanos qué hacés y dónde estás hoy. Comenzamos por entender tu punto de partida.</p>
        <Button href="/contacto/" variant="accent" size="lg">Agendar reunión</Button>
      </div>
    </div>
  </section>
  </div>
</Base>

<script>
  // Hilo conductor: arma una curva continua (Catmull-Rom) que baja por los márgenes y cruza
  // entre secciones por la zona de padding, sin pasar sobre el texto. Se recalcula al cambiar el tamaño.
  // El dibujo progresivo con el scroll es CSS (animation-timeline); sin soporte, el hilo se ve completo.
  const wrap = document.querySelector<HTMLElement>('.hilo-wrap');
  const svg = wrap?.querySelector<SVGSVGElement>('.hilo-svg');
  const path = svg?.querySelector('path');
  const pajaro = wrap?.querySelector<HTMLElement>('.pajaro');

  // El pájaro recorre la misma ruta que el hilo (CSS, ligado al scroll). Acá solo se le entrega la ruta.
  function rutaPajaro(d: string) {
    if (!pajaro) return;
    pajaro.style.setProperty('offset-path', `path("${d}")`);
    pajaro.classList.add('listo');
  }

  // Vuela mientras se desplaza la página y se posa cuando el scroll se detiene. Mira hacia el lado
  // al que avanza el hilo (clase izq) según el tramo de la curva que corresponde al scroll actual.
  const conMovimiento = !matchMedia('(prefers-reduced-motion: reduce)').matches
    && CSS.supports('animation-timeline', 'scroll(root)');
  function orientar() {
    if (!pajaro) return;
    if (!path || !svg?.classList.contains('listo')) { pajaro.classList.remove('izq'); return; }
    const total = path.getTotalLength();
    const maximo = document.documentElement.scrollHeight - window.innerHeight;
    const avance = maximo > 0 ? Math.min(1, Math.max(0, window.scrollY / maximo)) : 0;
    const largo = avance * total;
    const a = path.getPointAtLength(Math.max(0, largo - 30));
    const b = path.getPointAtLength(Math.min(total, largo + 30));
    if (Math.abs(b.x - a.x) > 25) pajaro.classList.toggle('izq', b.x < a.x);
  }
  if (pajaro && conMovimiento) {
    let reposo: number | undefined;
    let cuadro = 0;
    window.addEventListener('scroll', () => {
      pajaro.classList.add('vuela');
      clearTimeout(reposo);
      reposo = window.setTimeout(() => pajaro.classList.remove('vuela'), 200);
      if (!cuadro) cuadro = requestAnimationFrame(() => { cuadro = 0; orientar(); });
    }, { passive: true });
  }

  function curva(pts: number[][]) {
    const p = [pts[0], ...pts, pts[pts.length - 1]];
    let d = `M${p[1][0].toFixed(0)} ${p[1][1].toFixed(0)}`;
    for (let i = 1; i < p.length - 2; i++) {
      const [a, b, c, e] = [p[i - 1], p[i], p[i + 1], p[i + 2]];
      const c1 = [b[0] + (c[0] - a[0]) / 6, b[1] + (c[1] - a[1]) / 6];
      const c2 = [c[0] - (e[0] - b[0]) / 6, c[1] - (e[1] - b[1]) / 6];
      d += ` C${c1[0].toFixed(0)} ${c1[1].toFixed(0)} ${c2[0].toFixed(0)} ${c2[1].toFixed(0)} ${c[0].toFixed(0)} ${c[1].toFixed(0)}`;
    }
    return d;
  }

  function construir() {
    if (!wrap || !svg || !path) return;
    const W = wrap.clientWidth;
    const H = wrap.scrollHeight;
    const contenedor = wrap.querySelector('.container');
    const ancho = contenedor ? contenedor.getBoundingClientRect().width : 1120;
    const margen = (W - ancho) / 2;
    if (margen < 60) { svg.classList.remove('listo'); rutaPajaro(`M9 0L9 ${H}`); return; }
    const base = wrap.getBoundingClientRect().top;
    const secciones = Array.from(wrap.querySelectorAll<HTMLElement>(':scope > section')).map((s) => {
      const r = s.getBoundingClientRect();
      return { t: r.top - base, b: r.bottom - base };
    });
    const visual = wrap.querySelector<HTMLElement>('.hero-visual')?.getBoundingClientRect();
    if (!visual || secciones.length < 2) return;
    const xs = [margen / 2, W - margen / 2];
    const pts: number[][] = [[visual.left + visual.width / 2, visual.bottom - base - 40]];
    let lado = 1;
    const banda = 50;
    for (let i = 1; i < secciones.length; i++) {
      const { t, b } = secciones[i];
      const x = xs[lado];
      const onda = lado ? -14 : 14;
      pts.push([x, t + banda], [x + onda, (t + b) / 2]);
      if (i === secciones.length - 1) {
        pts.push([x, b - banda - 40], [W / 2, b - 30]);
      } else {
        pts.push([x, b - banda], [W / 2, b]);
        lado = 1 - lado;
      }
    }
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    const d = curva(pts);
    path.setAttribute('d', d);
    rutaPajaro(d);
    if (conMovimiento) orientar();
    svg.classList.add('listo');
  }

  // Entrada: se cierra con la primera interacción (respetando un mínimo para que la frase se lea)
  // o sola pasado el máximo. Los tiempos (data-min, data-max) se calculan arriba a partir del ritmo
  // de la frase. Se muestra una vez por sesión.
  const intro = document.getElementById('intro');
  if (intro && document.documentElement.classList.contains('intro-activa')) {
    const minimo = Number(intro.dataset.min) || 4000;
    const maximo = Number(intro.dataset.max) || 4500;
    const inicio = performance.now();
    let cerrada = false;
    const cerrar = () => {
      if (cerrada) return;
      cerrada = true;
      const resto = Math.max(0, minimo - (performance.now() - inicio));
      window.setTimeout(() => {
        intro.classList.add('intro-sale');
        document.documentElement.classList.remove('intro-activa');
        try { sessionStorage.setItem('intro-visto', '1'); } catch (e) {}
        window.setTimeout(() => { intro.remove(); construir(); }, 900);
      }, resto);
    };
    ['pointermove', 'pointerdown', 'wheel', 'touchstart', 'keydown'].forEach((t) =>
      window.addEventListener(t, cerrar, { once: true, passive: true }),
    );
    window.setTimeout(cerrar, maximo);
  }

  let espera: number | undefined;
  const programar = () => { clearTimeout(espera); espera = window.setTimeout(construir, 150); };
  construir();
  document.fonts?.ready.then(construir);
  window.addEventListener('load', construir);
  window.addEventListener('resize', programar);
</script>
