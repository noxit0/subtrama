---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PaqueteCard from '../components/PaqueteCard.astro';
import { getPaquetes, getSeccionesInicio, getProceso, getMarcas, getManifiesto } from '../lib/contenido';
import Marcas from '../components/Marcas.astro';
import HeroVisual from '../components/HeroVisual.astro';
const paquetes = await getPaquetes();
const secciones = await getSeccionesInicio();
const proceso = await getProceso();
const marcas = await getMarcas();
const manifiesto = await getManifiesto();
// El manifiesto va sobre el fondo base; el resto de las secciones alterna fondo arena y base.
const conFondo = secciones.filter((t) => t !== 'manifiesto');
const esAlt = (tipo: string) => tipo !== 'manifiesto' && conFondo.indexOf(tipo as never) % 2 === 0;
const dosDigitos = (n: number) => String(n).padStart(2, '0');
// Palabras separadas para animarlas una por una (entrada del título y manifiesto).
const titulo = 'Vos creás tu mundo. Nosotros lo contamos en redes.'.split(' ');
const manifiestoPalabras = manifiesto ? manifiesto.texto.trim().split(/\s+/) : [];
const manifiestoDestacadas = manifiesto?.destacado ? manifiesto.destacado.trim().split(/\s+/) : [];
---
<Base
  title="Subtrama | Gestión de contenido y redes sociales para marcas"
  description="Espacio de marketing digital. Ordenamos, publicamos y medimos el contenido en redes de marcas con oficio e historia. Vos creás tu mundo, nosotros lo contamos."
>
  {manifiesto && (
    <div class="intro" id="intro" aria-hidden="true">
      <p class="intro-frase">
        {manifiestoPalabras.map((p, n) => <><span class="intro-w" style={`--i:${n}`}>{p}</span>{' '}</>)}
        {manifiestoDestacadas.map((p, n) => (
          <><span class="intro-w intro-dest" style={`--i:${manifiestoPalabras.length + n + 1}`}>{p}{n === manifiestoDestacadas.length - 1 && '.'}</span>{n < manifiestoDestacadas.length - 1 && ' '}</>
        ))}
      </p>
      <svg class="intro-onda" style={`--n:${manifiestoPalabras.length + manifiestoDestacadas.length}`} viewBox="0 0 440 40" focusable="false"><path pathLength="1" d="M8 20 C 80 2 140 2 220 20 S 360 38 432 20" /></svg>
    </div>
  )}
  <noscript><style>.intro{display:none}</style></noscript>
  <script is:inline>
    (function () {
      var i = document.getElementById('intro');
      if (!i) return;
      try {
        if (sessionStorage.getItem('intro-visto') || matchMedia('(prefers-reduced-motion: reduce)').matches) { i.remove(); return; }
      } catch (e) {}
      document.documentElement.classList.add('intro-activa');
    })();
  </script>
  <div class="hilo-wrap">
  <svg class="hilo-svg" aria-hidden="true" focusable="false"><path pathLength="1" d="" /></svg>
  <span class="hilo-movil" aria-hidden="true"></span>
  <section class="hero">
    <div class="hero-copy surface-deep">
      <span class="st-eyebrow hero-fade" style="--d:0s">Espacio de marketing digital</span>
      <h1 class="display">
        {titulo.map((p, n) => <><span class="hero-palabra" style={`--i:${n}`}>{p}</span>{n < titulo.length - 1 && ' '}</>)}
      </h1>
      <p class="hero-lead hero-fade" style="--d:1s">
        Somos Subtrama. Ordenamos tu contenido y lo publicamos con estrategia, para que tu marca se cuente sola.
      </p>
      <div class="hero-actions hero-fade" style="--d:1.2s">
        <Button href="/contacto/" size="lg">Agendar reunión</Button>
        <Button href="/servicios/" size="lg" variant="inverse">Ver paquetes</Button>
      </div>
    </div>
    <div class="hero-visual">
      <HeroVisual />
    </div>
  </section>
  {secciones.map((tipo) => (
    <section class:list={['section', { 'section-alt': esAlt(tipo), manifiesto: tipo === 'manifiesto' }]}>
      {tipo === 'manifiesto' && manifiesto && (
        <div class="container">
          <p class="manifiesto-texto">
            {manifiestoPalabras.map((p, n) => <><span class="mw" style={`--i:${n}`}>{p}</span>{' '}</>)}
            {manifiestoDestacadas.map((p, n) => (
              <><span class="mw mw-dest" style={`--i:${manifiestoPalabras.length + n + 1}`}>{p}{n === manifiestoDestacadas.length - 1 && '.'}</span>{n < manifiestoDestacadas.length - 1 && ' '}</>
            ))}
          </p>
          {manifiestoDestacadas.length > 0 && (
            <svg class="manifiesto-onda" viewBox="0 0 440 40" aria-hidden="true" focusable="false"><path pathLength="1" d="M8 20 C 80 2 140 2 220 20 S 360 38 432 20" /></svg>
          )}
        </div>
      )}
      {tipo === 'para-quien' && (
        <div class="container">
          <div class="section-head">
            <SectionTitle title="Para quién trabajamos" />
            <p>
              Trabajamos con marcas que tienen oficio e historia: talleres, estudios y proyectos de autor. Las ayudamos a mostrarlo con constancia y criterio.
            </p>
          </div>
          {marcas.length > 0 && <Marcas />}
        </div>
      )}
      {tipo === 'paquetes' && (
        <div class="container">
          <div class="section-head">
            <SectionTitle title="Paquetes" />
            <p>Dos paquetes cerrados y uno a medida. Elegí según cuánto contenido necesitás publicar por mes.</p>
          </div>
          <div class="grid-cards grid-paquetes">
            {paquetes.map((p, i) => <PaqueteCard paquete={p} indice={i} as="h3" />)}
          </div>
          <p class="tabla-nota">El valor se informa en la propuesta. <a href="/servicios/">Ver la comparación y los servicios</a>.</p>
        </div>
      )}
      {tipo === 'como-se-trabaja' && (
        <div class="container proceso-wrap">
          <div class="section-head proceso-head">
            <SectionTitle title="Cómo trabajamos" />
            <p>Cada mes acordamos el calendario, publicamos y te mostramos qué pasó con cada pieza.</p>
          </div>
          <ol class="proceso">
            {proceso.map((paso, i) => (
              <li class="revelar">
                <span class="proceso-num" aria-hidden="true">{dosDigitos(i + 1)}</span>
                <div class="proceso-cuerpo">
                  <h3>{paso.titulo}</h3>
                  <p>{paso.texto}</p>
                  {paso.enlace_texto && paso.enlace_url && (
                    <a class="proceso-enlace" href={paso.enlace_url}>
                      {paso.enlace_texto}
                      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>
  ))}
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Contanos sobre tu marca</h2>
        <p>Contanos qué hacés y dónde estás hoy. Comenzamos por entender tu punto de partida.</p>
        <Button href="/contacto/" variant="accent" size="lg">Agendar reunión</Button>
      </div>
    </div>
  </section>
  </div>
</Base>

<script>
  // Hilo conductor: arma una curva continua (Catmull-Rom) que baja por los márgenes y cruza
  // entre secciones por la zona de padding, sin pasar sobre el texto. Se recalcula al cambiar el tamaño.
  // El dibujo progresivo con el scroll es CSS (animation-timeline); sin soporte, el hilo se ve completo.
  const wrap = document.querySelector<HTMLElement>('.hilo-wrap');
  const svg = wrap?.querySelector<SVGSVGElement>('.hilo-svg');
  const path = svg?.querySelector('path');

  function curva(pts: number[][]) {
    const p = [pts[0], ...pts, pts[pts.length - 1]];
    let d = `M${p[1][0].toFixed(0)} ${p[1][1].toFixed(0)}`;
    for (let i = 1; i < p.length - 2; i++) {
      const [a, b, c, e] = [p[i - 1], p[i], p[i + 1], p[i + 2]];
      const c1 = [b[0] + (c[0] - a[0]) / 6, b[1] + (c[1] - a[1]) / 6];
      const c2 = [c[0] - (e[0] - b[0]) / 6, c[1] - (e[1] - b[1]) / 6];
      d += ` C${c1[0].toFixed(0)} ${c1[1].toFixed(0)} ${c2[0].toFixed(0)} ${c2[1].toFixed(0)} ${c[0].toFixed(0)} ${c[1].toFixed(0)}`;
    }
    return d;
  }

  function construir() {
    if (!wrap || !svg || !path) return;
    const W = wrap.clientWidth;
    const H = wrap.scrollHeight;
    const contenedor = wrap.querySelector('.container');
    const ancho = contenedor ? contenedor.getBoundingClientRect().width : 1120;
    const margen = (W - ancho) / 2;
    if (margen < 60) { svg.classList.remove('listo'); return; }
    const base = wrap.getBoundingClientRect().top;
    const secciones = Array.from(wrap.querySelectorAll<HTMLElement>(':scope > section')).map((s) => {
      const r = s.getBoundingClientRect();
      return { t: r.top - base, b: r.bottom - base };
    });
    const visual = wrap.querySelector<HTMLElement>('.hero-visual')?.getBoundingClientRect();
    if (!visual || secciones.length < 2) return;
    const xs = [margen / 2, W - margen / 2];
    const pts: number[][] = [[visual.left + visual.width / 2, visual.bottom - base - 40]];
    let lado = 1;
    const banda = 50;
    for (let i = 1; i < secciones.length; i++) {
      const { t, b } = secciones[i];
      const x = xs[lado];
      const onda = lado ? -14 : 14;
      pts.push([x, t + banda], [x + onda, (t + b) / 2]);
      if (i === secciones.length - 1) {
        pts.push([x, b - banda - 40], [W / 2, b - 30]);
      } else {
        pts.push([x, b - banda], [W / 2, b]);
        lado = 1 - lado;
      }
    }
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    path.setAttribute('d', curva(pts));
    svg.classList.add('listo');
  }

  // Entrada: se cierra con la primera interacción (respetando un mínimo para que la frase se lea)
  // o sola a los 4,5 s. Se muestra una vez por sesión.
  const intro = document.getElementById('intro');
  if (intro && document.documentElement.classList.contains('intro-activa')) {
    const inicio = performance.now();
    let cerrada = false;
    const cerrar = () => {
      if (cerrada) return;
      cerrada = true;
      const resto = Math.max(0, 4000 -(performance.now() - inicio));
      window.setTimeout(() => {
        intro.classList.add('intro-sale');
        document.documentElement.classList.remove('intro-activa');
        try { sessionStorage.setItem('intro-visto', '1'); } catch (e) {}
        window.setTimeout(() => { intro.remove(); construir(); }, 900);
      }, resto);
    };
    ['pointermove', 'pointerdown', 'wheel', 'touchstart', 'keydown'].forEach((t) =>
      window.addEventListener(t, cerrar, { once: true, passive: true }),
    );
    window.setTimeout(cerrar, 4500);
  }

  let espera: number | undefined;
  const programar = () => { clearTimeout(espera); espera = window.setTimeout(construir, 150); };
  construir();
  document.fonts?.ready.then(construir);
  window.addEventListener('load', construir);
  window.addEventListener('resize', programar);
</script>
