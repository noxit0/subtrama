---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Lead from '../components/Lead.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Callout from '../components/Callout.astro';
import { getPaquetes, getCondiciones, formatoPrecio } from '../lib/contenido';
import Marcas from '../components/Marcas.astro';
const paquetes = await getPaquetes();
const cond = await getCondiciones();
---
<Base
  title="Subtrama | Espacio de marketing digital"
  description="Gestiono redes y estrategia de contenido para marcas de autor, talleres y estudios. Mientras vos creás tu mundo, yo lo cuento en redes."
>
  <section class="hero">
    <div class="container hero-inner">
      <span class="st-eyebrow">Espacio de marketing digital</span>
      <h1 class="display">Mientras vos creás tu mundo, yo lo cuento en redes.</h1>
      <p class="hero-lead">
        Soy Subtrama, la trama invisible que conecta tu historia con el mundo digital. Pienso creativamente y actúo con estrategia y organización.
      </p>
      <div class="hero-actions">
        <Button href="/contacto/" size="lg">Agendar reunión</Button>
        <Button href="/servicios/" size="lg" variant="secondary">Ver servicios</Button>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <SectionTitle title="Para quién trabajo" />
        <p>
          Gestiono redes y estrategia de contenido para marcas de autor, talleres y estudios: proyectos con oficio, historia y una firma detrás que merecen ser contados con criterio.
        </p>
      </div>
      <div class="grid-cards">
        <Card title="Diagnóstico" tone="surface">
          <Lead lead="Empiezo por los datos.">Nombro el problema antes de proponer una solución.</Lead>
        </Card>
        <Card title="Explicación" tone="surface">
          <Lead lead="Cada recomendación tiene su porqué.">La decisión final siempre es tuya.</Lead>
        </Card>
        <Card title="Alcance" tone="surface">
          <Lead lead="Lo que hago queda claro desde el principio.">Sin promesas difusas ni letra chica.</Lead>
        </Card>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <SectionTitle title="Paquetes" />
        <p>Cuatro formas de trabajar juntos. Tres paquetes cerrados y uno que se arma a medida.</p>
      </div>
      <div class="grid-cards">
        {paquetes.map((p, i) => (
          <a class="card-link" href={`/paquetes/${p.slug}/`}>
            <Card title={p.nombre} tone={i % 2 === 0 ? 'accent-2' : 'accent'} number={i + 1}>
              <h3 class="card-service">{p.precio != null ? `${formatoPrecio(p.precio)} por mes` : 'A medida'}</h3>
              <p>{p.resumen}</p>
              <span class="card-more">Ver detalle</span>
            </Card>
          </a>
        ))}
      </div>
      <p class="tabla-nota">{cond.nota_impuestos} Vigentes desde el {cond.vigencia_desde}. <a href="/servicios/">Ver la comparación y los servicios</a>.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <SectionTitle title="Marcas con las que trabajo" />
        <p>Proyectos con oficio e historia que ya cuentan su mundo en redes.</p>
      </div>
      <Marcas />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Callout label="Cómo se trabaja">
        <p>Cada mes se programa, se publica y se mide. El informe y la reunión de seguimiento se repiten con la frecuencia de cada paquete.</p>
      </Callout>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Hablemos de tu marca</h2>
        <p>Contame qué hacés y dónde estás hoy. Empezamos por entender el punto de partida.</p>
        <Button href="/contacto/" variant="accent" size="lg">Agendar reunión</Button>
      </div>
    </div>
  </section>
</Base>
