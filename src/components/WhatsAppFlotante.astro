---
import { sitio } from '../data/sitio';
import { getWhatsapp } from '../lib/contenido';
const { activo, mensaje } = await getWhatsapp();
const href = sitio.whatsapp ? `${sitio.whatsapp}?text=${encodeURIComponent(mensaje)}` : '';
---
{activo && href && (
  <a class="wa-flotante" href={href} target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
    <svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true" focusable="false">
      <path fill="currentColor" d="M16.04 3C9.4 3 4 8.4 4 15.04c0 2.12.55 4.19 1.6 6.01L4 29l8.14-1.56a12.04 12.04 0 0 0 3.9.65C22.68 28.09 28 22.7 28 16.04 28 9.4 22.68 3 16.04 3Zm0 22.05c-1.2 0-2.38-.32-3.4-.93l-.49-.29-4.83.93.96-4.7-.32-.5a9.97 9.97 0 0 1-1.52-5.3c0-5.52 4.5-10.01 10.04-10.01s10.04 4.49 10.04 10.01c0 5.53-4.5 10.01-10.04 10.01Zm5.5-7.5c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.95 1.18-.18.2-.35.22-.65.08-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.67-2.08-.18-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.38-.02-.53-.08-.15-.68-1.64-.93-2.25-.25-.58-.5-.5-.68-.5h-.58c-.2 0-.53.08-.8.38-.28.3-1.06 1.04-1.06 2.53 0 1.5 1.08 2.94 1.23 3.14.15.2 2.13 3.25 5.15 4.56.72.31 1.28.5 1.72.64.72.23 1.38.2 1.9.12.58-.09 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35Z" />
    </svg>
  </a>
)}

<style>
  .wa-flotante{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));z-index:50;display:grid;place-items:center;width:56px;height:56px;border-radius:50%;background:#25d366;color:#fff;box-shadow:0 6px 16px rgba(0,0,0,.25)}
  .wa-flotante:hover{background:#1ebe5b}
  .wa-flotante:focus-visible{outline:3px solid var(--brand-strong);outline-offset:3px}
  @media print{.wa-flotante{display:none}}
</style>
