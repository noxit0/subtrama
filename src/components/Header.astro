---
import Button from './Button.astro';
const path = Astro.url.pathname;
const links = [
  { href: '/servicios/', label: 'Servicios' },
  { href: '/nosotros/', label: 'Nosotros' },
  { href: '/contacto/', label: 'Contacto' },
];
const isActive = (href: string) => path.startsWith(href);
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-link" aria-label="Subtrama, inicio">
      <img src="/logos/subtrama-horizontal-positivo.svg" alt="Subtrama" width="1067" height="134" />
    </a>
    <details class="nav-toggle">
      <summary aria-label="Abrir menú"><span></span><span></span><span></span></summary>
      <nav class="main-nav" aria-label="Navegación principal">
        <ul>
          {links.map((l) => (
            <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
          ))}
          <li class="nav-cta"><Button href="/contacto/">Agendar reunión</Button></li>
        </ul>
      </nav>
    </details>
  </div>
</header>
