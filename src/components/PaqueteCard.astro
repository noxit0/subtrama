---
import Card from './Card.astro';
import type { Paquete } from '../lib/contenido';

interface Props {
  paquete: Paquete;
  indice: number;
  as?: 'h2' | 'h3';
}
const { paquete: p, indice, as: Heading = 'h3' } = Astro.props;

// Grilla del mes: un cuadrado por pieza de feed. Los videos llevan el símbolo de reproducir
// y, en los paquetes a medida, los cuadrados que faltan hasta el máximo se muestran punteados.
const g = p.grilla;
const piezas = g
  ? [
      ...Array(g.videos).fill('video'),
      ...Array(g.estaticas).fill('estatica'),
      ...Array(Math.max((g.hasta ?? 0) - g.videos - g.estaticas, 0)).fill('opcional'),
    ]
  : [];
const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
const leyenda = g
  ? g.hasta
    ? `Desde ${g.videos + g.estaticas} hasta ${g.hasta} piezas por mes`
    : [g.videos && plural(g.videos, 'video', 'videos'), g.estaticas && plural(g.estaticas, 'estática', 'estáticas')]
        .filter(Boolean)
        .join(' y ') + ' por mes'
  : (p.dato_tarjeta ?? (p.tipo === 'cerrado' ? 'Paquete cerrado' : 'A medida'));
// Filas comparables: las mismas en todas las tarjetas, en el mismo orden que la comparación de Servicios.
const filas = p.detalle
  ? [
      { label: 'Piezas de feed', valor: p.detalle.piezas },
      { label: 'Historias', valor: p.detalle.historias },
      { label: 'Jornada de registro', valor: p.detalle.jornada },
      { label: 'Informe', valor: p.detalle.informe },
      { label: 'Calendarización', valor: p.detalle.calendarizacion },
    ]
  : [];
---
<a class:list={['card-link', { destacado: p.destacado }]} href={`/paquetes/${p.slug}/`}>
  <Card tone={p.destacado ? 'deep' : 'surface'} class={p.destacado ? 'paq paq-deep' : 'paq'}>
    {p.destacado && <span class="cinta">Recomendado</span>}
    <Heading class="paquete-nombre">{p.nombre}</Heading>
    <p>{p.resumen}</p>
    {piezas.length > 0 && (
      <ul class="grilla" aria-hidden="true">
        {piezas.map((tipo) => (
          <li class={`pieza pieza-${tipo}`}>
            {tipo === 'video' && <svg viewBox="0 0 12 12" width="12" height="12"><path d="M3 1.5v9l7.5-4.5z" fill="currentColor" /></svg>}
          </li>
        ))}
      </ul>
    )}
    {filas.length === 0 && <p class="leyenda">{leyenda}</p>}
    {filas.length > 0 && (
      <dl class="filas">
        {filas.map((f) => (
          <div class="fila">
            <dt>{f.label}</dt>
            <dd>{f.valor}</dd>
          </div>
        ))}
      </dl>
    )}
    <span class="card-more">Ver detalle</span>
  </Card>
</a>

<style>
  /* Colores de la grilla y de las filas según el fondo de la tarjeta (crema o salvia profunda). */
  :global(.paq){--pz-video:var(--terracota-700);--pz-video-fg:var(--neutro-50);--pz-est:var(--surface-alt);--pz-borde:var(--terracota-700);--fila-borde:var(--border);--fila-label:var(--text-muted);--fila-valor:var(--brand-deep)}
  :global(.paq-deep){--pz-video:var(--accent);--pz-video-fg:var(--text);--pz-est:var(--on-brand-deep);--pz-borde:var(--accent);--fila-borde:rgba(255,245,233,.28);--fila-label:var(--on-brand-deep-muted);--fila-valor:var(--on-brand-deep)}
  .cinta{position:absolute;top:0;left:50%;transform:translate(-50%,-50%);white-space:nowrap;padding:2px var(--space-3);border-radius:var(--radius-pill);background:var(--accent-2);color:var(--on-accent);font-size:12px;line-height:20px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .paquete-nombre{font-family:var(--font-display);font-size:36px;line-height:40px;font-weight:400;text-transform:uppercase}
  .grilla{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
  .pieza{display:grid;place-items:center;width:30px;height:30px;border-radius:6px}
  .pieza-video{background:var(--pz-video);color:var(--pz-video-fg)}
  .pieza-estatica{background:var(--pz-est)}
  .pieza-opcional{border:2px dashed var(--pz-borde)}
  @media (max-width:699px){.grilla{gap:5px}.pieza{width:26px;height:26px}}
  .leyenda{font-weight:700}
  .filas{margin:0;display:grid}
  /* Etiqueta chica arriba y valor debajo, a todo el ancho: se lee bien en tarjetas angostas. */
  .fila{display:grid;gap:2px;padding-block:var(--space-2);border-top:1px solid var(--fila-borde)}
  .fila:last-child{border-bottom:1px solid var(--fila-borde)}
  .fila dt{color:var(--fila-label);font-size:11px;line-height:16px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .fila dd{margin:0;font-size:15px;line-height:22px;font-weight:700;color:var(--fila-valor)}
</style>
