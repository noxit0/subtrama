---
import Card from './Card.astro';
import type { Paquete } from '../lib/contenido';

interface Props {
  paquete: Paquete;
  indice: number;
  as?: 'h2' | 'h3';
}
const { paquete: p, indice, as: Heading = 'h3' } = Astro.props;

// Grilla del mes: un cuadrado por pieza de feed. Los videos llevan el símbolo de reproducir
// y, en los paquetes a medida, los cuadrados que faltan hasta el máximo se muestran punteados.
const g = p.grilla;
const piezas = g
  ? [
      ...Array(g.videos).fill('video'),
      ...Array(g.estaticas).fill('estatica'),
      ...Array(Math.max((g.hasta ?? 0) - g.videos - g.estaticas, 0)).fill('opcional'),
    ]
  : [];
const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;
const leyenda = g
  ? g.hasta
    ? `Desde ${g.videos + g.estaticas} hasta ${g.hasta} piezas por mes`
    : [g.videos && plural(g.videos, 'video', 'videos'), g.estaticas && plural(g.estaticas, 'estática', 'estáticas')]
        .filter(Boolean)
        .join(' y ') + ' por mes'
  : (p.dato_tarjeta ?? (p.tipo === 'cerrado' ? 'Paquete cerrado' : 'A medida'));
const datos = p.detalle
  ? [`Jornada: ${p.detalle.jornada}`, `Informe: ${p.detalle.informe}`]
  : p.tipo === 'personalizable'
    ? ['Servicios a elección']
    : [];
---
<a class:list={['card-link', { destacado: p.destacado }]} href={`/paquetes/${p.slug}/`}>
  <Card tone={indice % 2 === 0 ? 'accent-2' : 'accent'}>
    {p.destacado && <span class="cinta">Recomendado</span>}
    <Heading class="paquete-nombre">{p.nombre}</Heading>
    <p>{p.resumen}</p>
    {piezas.length > 0 && (
      <ul class="grilla" aria-hidden="true">
        {piezas.map((tipo) => (
          <li class={`pieza pieza-${tipo}`}>
            {tipo === 'video' && <svg viewBox="0 0 12 12" width="12" height="12"><path d="M3 1.5v9l7.5-4.5z" fill="currentColor" /></svg>}
          </li>
        ))}
      </ul>
    )}
    <p class="leyenda">{leyenda}</p>
    {datos.length > 0 && (
      <ul class="datos">
        {datos.map((d) => <li>{d}</li>)}
      </ul>
    )}
    <span class="card-more">Ver detalle</span>
  </Card>
</a>

<style>
  .destacado :global(.st-card){outline:3px solid var(--brand-strong);outline-offset:-3px}
  .cinta{position:absolute;top:0;left:50%;transform:translate(-50%,-50%);white-space:nowrap;padding:2px var(--space-3);border-radius:var(--radius-pill);background:var(--brand-strong);color:var(--text-inverse);font-size:12px;line-height:20px;font-weight:700;letter-spacing:.08em;text-transform:uppercase}
  .paquete-nombre{font-family:var(--font-display);font-size:36px;line-height:40px;font-weight:400;text-transform:uppercase}
  .grilla{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:6px}
  .pieza{display:grid;place-items:center;width:30px;height:30px;border-radius:6px}
  .pieza-video{background:var(--terracota-800);color:var(--neutro-50)}
  .pieza-estatica{background:var(--surface)}
  .pieza-opcional{border:2px dashed var(--terracota-800)}
  @media (max-width:699px){.grilla{gap:5px}.pieza{width:26px;height:26px}}
  .leyenda{font-weight:700}
  .datos{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:var(--space-2);font-size:12px;line-height:18px}
  .datos li{padding:2px var(--space-3);border-radius:var(--radius-pill);background:var(--bg);color:var(--text)}
</style>
