---
import { Image } from 'astro:assets';
import { getMarcas } from '../lib/contenido';
const marcas = await getMarcas();
const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/marcas/*.{png,jpg,jpeg,webp,svg}', { eager: true });
---
<div class="carrusel" role="group" aria-roledescription="carrusel" aria-label="Marcas con las que trabajamos">
  <button type="button" class="carrusel-btn" data-dir="-1" aria-label="Marcas anteriores" hidden>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
  <div class="carrusel-vista" tabindex="0" aria-label="Lista de marcas">
    <ul class="marcas">
      {marcas.map((m) => {
        const contenido = (
          <>
            <span class="marca-logo">
              {m.logo && logos[m.logo] ? (
                <Image src={logos[m.logo].default} alt={`Logo de ${m.nombre}`} height={160} loading="lazy" decoding="async" />
              ) : (
                <span class="marca-nombre">{m.nombre}</span>
              )}
            </span>
            <span class="marca-rubro">{m.rubro}</span>
          </>
        );
        return <li class="marca">{m.url ? <a href={m.url} rel="noopener">{contenido}</a> : <div class="marca-in">{contenido}</div>}</li>;
      })}
    </ul>
  </div>
  <button type="button" class="carrusel-btn" data-dir="1" aria-label="Marcas siguientes" hidden>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.carrusel').forEach((root) => {
    const vista = root.querySelector<HTMLElement>('.carrusel-vista')!;
    const botones = root.querySelectorAll<HTMLButtonElement>('.carrusel-btn');
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const actualizar = () => {
      const hayExceso = vista.scrollWidth > vista.clientWidth + 2;
      botones.forEach((b) => (b.hidden = !hayExceso));
    };
    botones.forEach((b) =>
      b.addEventListener('click', () => {
        const dir = Number(b.dataset.dir);
        const item = vista.querySelector<HTMLElement>('.marca');
        const paso = item ? item.getBoundingClientRect().width : vista.clientWidth;
        const fin = vista.scrollLeft + vista.clientWidth >= vista.scrollWidth - 2;
        const inicio = vista.scrollLeft <= 2;
        const behavior: ScrollBehavior = reducido ? 'auto' : 'smooth';
        if (dir > 0 && fin) vista.scrollTo({ left: 0, behavior });
        else if (dir < 0 && inicio) vista.scrollTo({ left: vista.scrollWidth, behavior });
        else vista.scrollBy({ left: dir * paso, behavior });
      }),
    );
    new ResizeObserver(actualizar).observe(vista);
    actualizar();
  });
</script>

<style>
  .carrusel{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:var(--space-3)}
  .carrusel-vista{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;border-radius:var(--radius-md,12px)}
  .carrusel-vista::-webkit-scrollbar{display:none}
  .marcas{list-style:none;padding:0;margin:0;display:flex;width:100%;justify-content:safe center}
  .marca{flex:0 0 calc(100% / 4);scroll-snap-align:start;padding-inline:var(--space-3);box-sizing:border-box;display:grid;justify-items:center;text-align:center}
  .marca a,.marca-in{display:grid;gap:var(--space-2);justify-items:center;color:inherit;text-decoration:none;width:100%}
  .marca-logo{display:flex;align-items:center;justify-content:center;height:80px;width:100%}
  .marca-logo :global(img){max-height:80px;max-width:min(100%,220px);width:auto;height:auto;object-fit:contain}
  .marca-nombre{font-family:var(--font-display);font-size:30px;line-height:34px;text-transform:uppercase;color:var(--brand-strong)}
  .marca-rubro{font-size:14px;line-height:20px;color:var(--text-muted)}
  .carrusel-btn{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;border:1.5px solid var(--brand-strong);background:var(--surface);color:var(--brand-strong);cursor:pointer}
  .carrusel-btn[hidden]{display:none}
  .carrusel-btn:hover{background:var(--brand-strong);color:var(--on-brand)}
  @media (max-width:900px){.marca{flex-basis:50%}}
  @media (max-width:520px){.marca{flex-basis:100%}.carrusel{gap:var(--space-2)}}
</style>
